# Enables tool-using Red and Blue agents on new runs. Without a key, Hex runs a local practice exercise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional TypeSafe Jev triage signal. Obtain this key from TypeSafe.
JEV_API_KEY=

# Optional override for the local SQLite file.
# HEX_DB_PATH=.data/hex.sqlite
