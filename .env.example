# Copy to .env and fill in what you need. Every setting is optional.

# --- AI provider -------------------------------------------------------------
# Powers the agent-mode lab and the optional AI pass in project reviews.
# Set one key. With both set, OpenAI is used unless LLM_PROVIDER=groq.
# Without a key, Hex runs a scripted practice exercise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM_PROVIDER=groq

# --- GitHub ------------------------------------------------------------------
# Fine-grained token for the watched repositories:
#   Contents: read and write        (private repos, commit comments)
#   Commit statuses: read and write (pass/fail status on each commit)
# Also raises GitHub's API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=

# Repositories to review on every push, comma-separated, optional @branch.
# HEX_WATCH_REPOS=owner/repo,owner/other@main

# Poll interval in seconds. Default 10 with a token (minimum 5), 60 without.
# HEX_POLL_SECONDS=10

# Webhook secret. GitHub signs each delivery with it; unsigned requests are rejected.
# Generate one with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=

# Link used in commit statuses and comments.
# HEX_PUBLIC_URL=http://localhost:3000

# Set to 0 to skip the AI pass or the commit comment on push reviews.
# HEX_LIVE_AI=1
# HEX_COMMIT_COMMENTS=1

# Through a tunnel, only the webhook endpoint is reachable. Set to 1 only for a
# deployment that has its own access control.
# HEX_ALLOW_REMOTE=0

# --- Other -------------------------------------------------------------------
# Optional advisory escalation score from TypeSafe.
JEV_API_KEY=

# SQLite location for run history. Push reviews are stored beside it in live/.
# HEX_DB_PATH=.data/hex.sqlite
